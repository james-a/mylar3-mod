{
  "name": "Mylar3 dev",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/mylar3,type=bind,consistency=cached",
  "workspaceFolder": "/workspace/mylar3",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy"
      ],
      "settings": {
        "python.terminal.activateEnvironment": true,
        "python.analysis.extraPaths": [
          "/workspace/mylar3/lib"
        ],
        "remote.autoForwardPorts": true
      }
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/comics,target=/comics,type=bind,consistency=cached"
  ],
  "forwardPorts": [8090],
  "portsAttributes": {
    "8090": {
      "label": "Mylar web UI",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "cd /workspace/mylar3 && python3 -m pip install -U pip setuptools wheel && python3 -m pip install -r requirements.txt",
  "postStartCommand": "cd /workspace/mylar3 && python3 devtools/ensure_dev_environment.py --no-venv",
  "remoteUser": "vscode"
}
