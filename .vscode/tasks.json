{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Mylar: Full dev setup",
      "type": "shell",
      "command": "python devtools/ensure_dev_environment.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Mylar: Dev + optional sample library (scripted CV import)",
      "type": "shell",
      "command": "python devtools/ensure_dev_environment.py --with-sample-library",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Mylar: Save dev baseline (mylar.db + library snapshot)",
      "type": "shell",
      "command": "python devtools/save_dev_baseline.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Mylar: Restore dev baseline (stop server first)",
      "type": "shell",
      "command": "python devtools/restore_dev_baseline.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Mylar: Watch Cursor agent 5e24c61f, then dev setup + start",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File devtools/watch_cursor_agent_and_run_mylar.ps1 -AgentId 5e24c61f-66f3-4b7c-8243-7d78c864782d",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Mylar: Start server",
      "type": "shell",
      "windows": {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File devtools/run_mylar_dev.ps1"
      },
      "linux": {
        "command": "bash devtools/run_mylar_dev.sh"
      },
      "osx": {
        "command": "bash devtools/run_mylar_dev.sh"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    }
  ]
}
